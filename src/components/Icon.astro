---
import type { IconConfig } from '../config/schema';
import { getSvgPathData, resolveIconSource } from '../config/icons';

interface Props {
  icon?: IconConfig;
}

const { icon } = Astro.props;
const iconSource = resolveIconSource(icon);
const pathData = iconSource ? getSvgPathData(iconSource) : '';
const escapedIconSource = iconSource.replace(/\\/g, '\\\\').replace(/'/g, "\\'");
---

{
  pathData ? (
    <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" fill="currentColor">
      <path d={pathData} />
    </svg>
  ) : iconSource ? (
    <span class="link-button-icon-wrapper">
      <span
        class="link-button-icon"
        style={`background-color: currentColor; -webkit-mask-image: url('${escapedIconSource}'); mask-image: url('${escapedIconSource}');`}
      />
    </span>
  ) : null
}
