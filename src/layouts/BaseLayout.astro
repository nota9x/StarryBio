---
import { ClientRouter } from 'astro:transitions';
import '@fontsource/inter/latin-300.css';
import '@fontsource/inter/latin-400.css';
import '@fontsource/inter/latin-600.css';
import '@fontsource/inter/latin-700.css';
import '@fontsource/inter/latin-900.css';
import '@fontsource/nunito-sans/latin-400.css';
import '@fontsource/nunito-sans/latin-700.css';
import '@fontsource/nunito-sans/latin-800.css';
import '@fontsource/nunito-sans/latin-900.css';
import '@fontsource/orbitron/latin-400.css';
import '@fontsource/orbitron/latin-700.css';
import '@fontsource/orbitron/latin-900.css';
import Analytics from '../components/Analytics.astro';
import SEO from '../components/SEO.astro';
import { getAnnouncementKey } from '../config/announcement';
import { toAbsoluteAssetPath } from '../config/image-assets';
import type { NormalizedStarryBioConfig } from '../config/schema';
import { buildContentSecurityPolicy } from '../config/security-headers';
import {
  getThemePresetDefinition,
  getThemeStyle,
  resolveProfileImageShape,
} from '../config/themes';
import { toStaticAssetPath } from '../config/urls';
import '../styles/input.css';

interface Props {
  config: NormalizedStarryBioConfig;
  title?: string;
  description?: string;
  includeStatus?: boolean;
}

const { config, title, description, includeStatus = true } = Astro.props;

const animation = config.animation;
const statusConfig = includeStatus ? config.status : undefined;
const showStarfield = config.theme.background === 'starfield';
const themeDefinition = getThemePresetDefinition(config.theme.preset);
const announcementKey = getAnnouncementKey(config.announcement);
const profileImageShape = resolveProfileImageShape(config.theme.preset, config.profile.imageShape);
const metaContentSecurityPolicy = buildContentSecurityPolicy(config.analytics, {
  includeFrameAncestors: false,
});
---

<!doctype html>
<html
  lang="en"
  data-theme={config.theme.preset}
  data-theme-appearance={themeDefinition.appearance}
  data-theme-background={config.theme.background}
  data-button-style={config.theme.buttonStyle}
  data-profile-image-shape={profileImageShape}
  data-announcement-key={announcementKey}
  data-announcement-state={announcementKey ? 'pending' : undefined}
  style={getThemeStyle(config.theme, config.profile.imageShape)}
>
  <head>
    <meta charset="UTF-8" />
    <meta http-equiv="Content-Security-Policy" content={metaContentSecurityPolicy} />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <SEO config={config} title={title} description={description} />

    {announcementKey && <script is:inline src={toStaticAssetPath('announcement-state.js')} />}

    {config.favicon && <link rel="icon" href={toAbsoluteAssetPath(config.favicon)} />}

    <ClientRouter />
    <Analytics analytics={config.analytics} />
  </head>

  <body>
    {showStarfield && (
      <div
        class="stars-container"
        aria-hidden="true"
        data-star-multiplier={animation?.starMultiplier ?? 1}
        data-shooting-star-multiplier={animation?.shootingStarMultiplier ?? 1}
        data-animation-intensity={config.theme.animationIntensity}
        data-starfield-effect={themeDefinition.starfieldEffect}
        transition:name="starfield"
        transition:animate="none"
        transition:persist
      />
    )}

    <slot />

    {statusConfig?.enabled && (
      <template id="starrybio-status-config">{JSON.stringify(statusConfig)}</template>
    )}
    <script>
      import '../scripts/app';
    </script>
  </body>
</html>
