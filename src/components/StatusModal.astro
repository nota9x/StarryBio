---
import type { StarryBioConfig } from '../config/schema';

interface Props {
  status?: StarryBioConfig['status'];
}

const { status } = Astro.props;
---

{
  status?.enabled && (
    <div id="status-modal" class="hidden">
      <div id="status-modal-overlay" />
      <div id="status-modal-content">
        <button
          id="status-modal-close"
          class="flex items-center justify-center"
          aria-label="Close schedule"
        >
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M6 18L18 6M6 6l12 12"
            />
          </svg>
        </button>
        <h2 id="status-modal-title" class="text-2xl font-bold text-white mb-6 text-center">
          Schedule
        </h2>
        <div class="space-y-6">
          <div>
            <h3 id="status-modal-weekday-title" class="text-lg font-semibold text-white mb-3">
              Weekdays
            </h3>
            <ul id="weekday-schedule-list" class="schedule-list bg-black/20 rounded-lg p-1" />
          </div>
          <div>
            <h3 id="status-modal-weekend-title" class="text-lg font-semibold text-white mb-3">
              Weekends
            </h3>
            <ul id="weekend-schedule-list" class="schedule-list bg-black/20 rounded-lg p-1" />
          </div>
        </div>
      </div>
    </div>
  )
}
