{
  "name": "starry-bio",
  "version": "3.6.0",
  "private": true,
  "description": "A fully customizable, high-performance \"link-in-bio\" website template built with Astro.",
  "license": "GPL-3.0-only",
  "type": "module",
  "scripts": {
    "astro": "astro",
    "build": "pnpm run validate && pnpm run build:icons && pnpm run generate && astro build",
    "build:icons": "node ./scripts/build-simple-icons.ts",
    "check": "pnpm run format:check && pnpm run lint && pnpm run typecheck && pnpm run test:unit",
    "commitlint": "commitlint --last --verbose",
    "deploy": "pnpm run deploy:cloudflare",
    "deploy:cloudflare": "pnpm run build && wrangler deploy",
    "dev": "pnpm run validate && pnpm run build:icons && pnpm run generate && astro dev",
    "fmt": "pnpm run format",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "generate": "node ./scripts/generate-assets.ts",
    "headers": "node ./scripts/generate-security-headers.ts",
    "icons": "pnpm run build:icons",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix --max-warnings 0",
    "preview": "pnpm run build && astro preview",
    "preview:cloudflare": "pnpm run build && wrangler dev",
    "release:check": "pnpm run check && pnpm run test:integration && pnpm run test:upstream && pnpm run test:e2e && pnpm run test:e2e:fixtures && pnpm audit",
    "release:package": "node ./scripts/create-update-artifact.ts",
    "release:verify-artifact": "node ./scripts/verify-update-artifact.ts",
    "starrybio:update": "node ./scripts/update-repository.ts",
    "start": "pnpm run dev",
    "test": "pnpm run test:downstream",
    "test:downstream": "pnpm run test:unit && pnpm run test:integration",
    "test:e2e": "pnpm run build && playwright test",
    "test:e2e:fixtures": "node ./scripts/test-fixture-deployments.ts",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:unit": "vitest run",
    "test:upstream": "vitest run --config vitest.upstream.config.ts",
    "typecheck": "astro check && tsc --noEmit",
    "validate": "node ./scripts/validate-config.ts"
  },
  "dependencies": {
    "@lucide/astro": "^1.81.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@axe-core/playwright": "^4.14.1",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@eslint/js": "^10.0.1",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/nunito-sans": "^5.3.0",
    "@fontsource/orbitron": "^5.3.0",
    "@playwright/test": "^1.65.1",
    "@resvg/resvg-js": "^2.6.2",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^26.6.11",
    "@types/qrcode": "^1.5.6",
    "@types/semver": "^7.8.0",
    "@types/snappyjs": "^0.7.1",
    "@typescript-eslint/parser": "^8.74.0",
    "astro": "^7.4.13",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-astro": "^3.2.2",
    "eslint-plugin-import-x": "^4.18.1",
    "eslint-plugin-jsx-a11y-x": "^0.2.0",
    "eslint-plugin-regexp": "^3.3.3",
    "eslint-plugin-unicorn": "^80.0.0",
    "globals": "^17.14.0",
    "node-diff3": "^4.0.0",
    "prettier": "^3.10.1",
    "prettier-plugin-astro": "^1.1.2",
    "prettier-plugin-packagejson": "^3.1.0",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "qrcode": "^1.5.4",
    "semver": "^7.8.6",
    "sigstore": "^5.0.1",
    "simple-icons": "^16.38.1",
    "snappyjs": "^0.7.0",
    "tailwindcss": "^4.3.5",
    "tar": "^7.5.23",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.74.0",
    "vitest": "^5.1.2",
    "wrangler": "^4.168.0",
    "zod": "^4.6.7"
  },
  "packageManager": "pnpm@12.24.0",
  "engines": {
    "node": "^26.13.1"
  }
}
