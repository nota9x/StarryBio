{
  "name": "starry-bio",
  "version": "3.0.0",
  "description": "A customizable, build-time generated Astro link-in-bio page for Cloudflare Workers.",
  "packageManager": "pnpm@11.5.3+sha512.7ac1c919341c213a34dc0d02afb7143c5c26ac26ee8c4782deea821b8ac64d2134a081fd8941dae6e29bbb48f58dfc2b7fbceeccc07cb2f09d219d342a4969ed",
  "scripts": {
    "dev": "pnpm run validate && pnpm run build:css && astro dev",
    "start": "pnpm run dev",
    "preview": "pnpm run build && wrangler dev",
    "deploy": "pnpm run build && wrangler deploy",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "fmt": "pnpm run format",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "astro check && tsc --noEmit",
    "validate": "tsx ./scripts/validate-config.ts",
    "icons": "pnpm run build:icons",
    "generate": "tsx ./scripts/generate-assets.ts",
    "build": "pnpm run validate && pnpm run build:icons && pnpm run generate && pnpm run build:css && astro build && node -e \"console.log('✓ Generated static pages'); console.log('✓ Build complete')\"",
    "build:icons": "tsx ./scripts/build-simple-icons.ts",
    "build:css": "tailwindcss -i ./src/styles/input.css -o ./public/style.css",
    "watch:css": "tailwindcss -i ./src/styles/input.css -o ./public/style.css --watch",
    "astro": "astro"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.4",
    "@astrojs/cloudflare": "^12.6.13",
    "@cloudflare/workers-types": "^4.20260604.1",
    "@eslint/js": "^9.39.4",
    "@resvg/resvg-js": "^2.6.2",
    "@tailwindcss/cli": "^4.3.0",
    "@types/node": "^25.9.2",
    "@types/qrcode": "^1.5.6",
    "@typescript-eslint/parser": "^8.61.0",
    "astro": "^5.15.6",
    "autoprefixer": "^10.5.0",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-astro": "^1.7.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "globals": "^17.6.0",
    "postcss": "^8.5.15",
    "prettier": "^3.8.3",
    "prettier-plugin-astro": "^0.14.1",
    "qrcode": "^1.5.4",
    "tailwindcss": "^4.3.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.61.0",
    "wrangler": "^4.98.0"
  },
  "private": true
}
