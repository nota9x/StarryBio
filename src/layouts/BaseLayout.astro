---
import { ClientRouter } from 'astro:transitions';
import { getImage } from 'astro:assets';
import Analytics from '../components/Analytics.astro';
import SEO from '../components/SEO.astro';
import type { NormalizedStarryBioConfig, StatusDefinition } from '../config/schema';
import {
  isImageMetadata,
  isLocalImagePath,
  isSvgImagePath,
  resolveImageAsset,
  toAbsoluteAssetPath,
} from '../config/image-assets';
import { getThemeStyle } from '../config/themes';

interface Props {
  config: NormalizedStarryBioConfig;
  title?: string;
  description?: string;
  includeStatus?: boolean;
}

const { config, title, description, includeStatus = true } = Astro.props;

const animation = config.animation;
const statusConfig = includeStatus ? await optimizeStatusImageAssets(config.status) : undefined;

async function optimizeStatusImageAssets(status: NormalizedStarryBioConfig['status']) {
  if (!status?.enabled) return status;

  return {
    ...status,
    default: await optimizeStatusDefinition(status.default),
    types: Object.fromEntries(
      await Promise.all(
        Object.entries(status.types).map(async ([name, definition]) => [
          name,
          await optimizeStatusDefinition(definition),
        ])
      )
    ),
  };
}

async function optimizeStatusDefinition(definition: StatusDefinition): Promise<StatusDefinition> {
  if (typeof definition.icon !== 'string') return definition;
  if (!isLocalImagePath(definition.icon) || isSvgImagePath(definition.icon)) return definition;

  const resolvedIcon = resolveImageAsset(definition.icon);
  if (!isImageMetadata(resolvedIcon)) {
    return {
      ...definition,
      icon: toAbsoluteAssetPath(definition.icon),
    };
  }

  const optimizedIcon = await getImage({
    src: resolvedIcon,
    width: 48,
    height: 48,
    format: 'webp',
    quality: 82,
  });

  return {
    ...definition,
    icon: optimizedIcon.src,
  };
}
---

<!doctype html>
<html
  lang="en"
  data-theme={config.theme.preset}
  data-theme-mode={config.theme.mode}
  data-button-style={config.theme.buttonStyle}
  style={getThemeStyle(config.theme)}
>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <SEO config={config} title={title} description={description} />

    {config.favicon && <link rel="icon" href={toAbsoluteAssetPath(config.favicon)} />}

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;600;700;900&family=Nunito+Sans:wght@400;700;800;900&family=Orbitron:wght@400;700;900&display=swap"
      rel="stylesheet"
    />

    <link rel="stylesheet" href="/style.css" />
    <ClientRouter />
    <Analytics analytics={config.analytics} />
  </head>

  <body>
    <div
      class="stars-container"
      aria-hidden="true"
      data-star-multiplier={animation?.starMultiplier ?? 1}
      data-shooting-star-multiplier={animation?.shootingStarMultiplier ?? 1}
      data-animation-intensity={config.theme.animationIntensity}
      transition:name="starfield"
      transition:animate="none"
      transition:persist
    >
    </div>

    <slot />

    {
      statusConfig?.enabled && (
        <template id="starrybio-status-config">{JSON.stringify(statusConfig)}</template>
      )
    }
    <script is:inline src="/app.js" defer></script>
  </body>
</html>
