{
  "name": "starry-bio",
  "version": "3.2.0",
  "type": "module",
  "description": "A customizable link-in-bio page built with Astro for Cloudflare Workers.",
  "packageManager": "pnpm@11.23.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "pnpm run validate && pnpm run build:icons && pnpm run generate && astro dev",
    "start": "pnpm run dev",
    "preview": "pnpm run build && wrangler dev",
    "deploy": "pnpm run build && wrangler deploy",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "fmt": "pnpm run format",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "astro check && tsc --noEmit",
    "test": "pnpm run test:unit",
    "test:unit": "vitest run",
    "test:e2e": "pnpm run build && playwright test",
    "validate": "tsx ./scripts/validate-config.ts",
    "icons": "pnpm run build:icons",
    "generate": "tsx ./scripts/generate-assets.ts",
    "build": "pnpm run validate && pnpm run build:icons && pnpm run generate && astro build",
    "build:icons": "tsx ./scripts/build-simple-icons.ts",
    "release:check": "pnpm run format:check && pnpm run lint && pnpm run typecheck && pnpm run test:unit && pnpm run build && playwright test && pnpm audit --prod",
    "update:repo": "tsx ./scripts/update-repository.ts",
    "astro": "astro"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10.0.1",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/nunito-sans": "^5.3.0",
    "@fontsource/orbitron": "^5.3.0",
    "@playwright/test": "^1.62.1",
    "@resvg/resvg-js": "^2.6.2",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.13.3",
    "@types/qrcode": "^1.5.6",
    "@typescript-eslint/parser": "^8.68.0",
    "astro": "^7.2.6",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-astro": "^3.1.0",
    "globals": "^17.11.0",
    "prettier": "^3.9.6",
    "prettier-plugin-astro": "^0.14.1",
    "qrcode": "^1.5.4",
    "simple-icons": "^16.28.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.12",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.68.0",
    "vitest": "^4.1.11",
    "wrangler": "^4.125.0",
    "zod": "^4.4.3"
  },
  "private": true,
  "dependencies": {
    "@lucide/astro": "^1.33.0"
  }
}
