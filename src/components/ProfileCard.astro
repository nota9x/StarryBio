---
import { QrCode } from '@lucide/astro';
import { toAbsoluteAssetPath } from '../config/image-assets';
import type { NormalizedStarryBioConfig } from '../config/schema';
import { STARRYBIO_VERSION } from '../config/version';
import { toGeneratedAssetUrl } from '../config/urls';
import FeaturedCards from './FeaturedCards.astro';
import LinkSections from './LinkSections.astro';
import StatusIndicator from './StatusIndicator.astro';

interface Props {
  config: NormalizedStarryBioConfig;
}

const { config } = Astro.props;
const currentYear = new Date().getFullYear();
const copyright = (config.footer?.copyright || `© ${currentYear} StarryBio`).replace(
  '{year}',
  String(currentYear)
);
const profileClasses = [
  'profile-card',
  `layout-${config.layout.mode}`,
  `links-${config.layout.linkStyle}`,
  `profile-position-${config.layout.profilePosition}`,
  config.profile.layout === 'horizontal' ? 'layout-horizontal' : '',
  config.theme.buttonStyle === 'terminal' ? 'theme-terminal' : '',
]
  .filter(Boolean)
  .join(' ');
const showFeaturedAbove = config.layout.featuredPosition === 'above-links';
const qrHref = config.qr?.enabled ? toGeneratedAssetUrl(config.qr.output, 'public/qr.png') : '';
const contactHref = config.contactCard?.enabled
  ? toGeneratedAssetUrl(config.contactCard.output, 'public/contact.vcf')
  : '';
---

<div class="content-wrapper layout-shell" data-layout={config.layout.mode}>
  <main class={profileClasses} transition:name="main-card">
    <div class="card-shine"></div>

    <div class="profile-primary">
      <header class="profile-header">
        <div class="profile-image-wrapper">
          <div class="profile-image-container">
            <img
              src={toAbsoluteAssetPath(config.profile.image)}
              alt={config.profile.name}
              width="120"
              height="120"
              loading="eager"
              fetchpriority="high"
            />
          </div>
          <StatusIndicator status={config.status} />
        </div>

        <div class="profile-text-content">
          <h1 class="profile-name">{config.profile.name}</h1>
          <p class="profile-description">{config.profile.description}</p>
        </div>
      </header>

      <div class="profile-actions" aria-label="Profile actions">
        {
          qrHref && (
            <a
              href={qrHref}
              class="mini-action mini-action-icon"
              aria-label="Download QR code"
              download
              data-astro-reload
            >
              <QrCode size={20} aria-hidden="true" />
            </a>
          )
        }
        {
          contactHref && (
            <a href={contactHref} class="mini-action" download data-astro-reload>
              Add Contact
            </a>
          )
        }
      </div>
    </div>

    <div class="profile-content">
      {showFeaturedAbove && <FeaturedCards featured={config.featured} />}
      <LinkSections sections={config.sections} />
      {!showFeaturedAbove && <FeaturedCards featured={config.featured} />}
    </div>

    <p class="footer-text">{copyright}</p>
  </main>

  <p class="footer-text powered-by text-center mt-4 text-xs">
    <a
      href="https://github.com/nota9x/StarryBio"
      target="_blank"
      rel="noopener noreferrer"
      class="hover:underline opacity-75 hover:opacity-100 transition-opacity"
    >
      Powered by StarryBio v{STARRYBIO_VERSION}
    </a>
  </p>
</div>
