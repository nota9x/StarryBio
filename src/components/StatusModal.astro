---
import { X } from '@lucide/astro';
import type { StarryBioConfig } from '../config/schema';

interface Props {
  status?: StarryBioConfig['status'];
}

const { status } = Astro.props;
---

{
  status?.enabled && (
    <dialog id="status-modal" aria-labelledby="status-modal-title">
      <div id="status-modal-content">
        <button id="status-modal-close" type="button" aria-label="Close schedule">
          <X size={24} aria-hidden="true" />
        </button>
        <h2 id="status-modal-title" class="text-2xl font-bold text-white mb-6 text-center">
          Schedule
        </h2>
        <div class="space-y-6">
          <section>
            <h3 class="text-lg font-semibold text-white mb-3">Weekdays</h3>
            <ul id="weekday-schedule-list" class="schedule-list bg-black/20 rounded-lg" />
          </section>
          <section>
            <h3 class="text-lg font-semibold text-white mb-3">Weekends</h3>
            <ul id="weekend-schedule-list" class="schedule-list bg-black/20 rounded-lg" />
          </section>
        </div>
      </div>
    </dialog>
  )
}
