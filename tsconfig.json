{
  "compilerOptions": {
    "target": "esnext",
    "module": "esnext",
    "lib": ["dom", "dom.iterable", "esnext"],
    "types": ["astro/client", "@cloudflare/workers-types"],
    "moduleResolution": "bundler",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "jsx": "preserve",
    "jsxImportSource": "astro"
  },
  "include": [
    "astro.config.mjs",
    "config/**/*.ts",
    "scripts/**/*.ts",
    "src/**/*.ts",
    "src/**/*.astro"
  ]
}
