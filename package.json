{
  "name": "starry-bio",
  "version": "2.0.0",
  "description": "A customizable, starry-themed Link-in-Bio page powered by Cloudflare Workers.",
  "packageManager": "pnpm@11.5.0",
  "scripts": {
    "start": "pnpm run build:css && wrangler dev",
    "deploy": "pnpm run build:css && wrangler deploy",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "build:css": "tailwindcss -i ./src/site/input.css -o ./src/site/style.css",
    "watch:css": "tailwindcss -i ./src/site/input.css -o ./src/site/style.css --watch"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260604.1",
    "@tailwindcss/cli": "^4.3.0",
    "autoprefixer": "^10.5.0",
    "postcss": "^8.5.15",
    "prettier": "^3.8.3",
    "tailwindcss": "^4.3.0",
    "typescript": "^5.9.3",
    "wrangler": "^4.98.0"
  },
  "private": true
}
