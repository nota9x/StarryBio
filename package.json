{
  "name": "starry-bio",
  "version": "2.0.0",
  "description": "A customizable, starry-themed Link-in-Bio page powered by Cloudflare Workers.",
  "packageManager": "pnpm@11.5.1",
  "scripts": {
    "start": "pnpm run build && wrangler dev",
    "deploy": "pnpm run build && wrangler deploy",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "build": "pnpm run build:icons && pnpm run build:css",
    "build:icons": "node ./scripts/build-simple-icons.mjs",
    "build:css": "tailwindcss -i ./src/site/input.css -o ./src/site/style.css",
    "watch:css": "tailwindcss -i ./src/site/input.css -o ./src/site/style.css --watch"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260702.1",
    "@tailwindcss/cli": "^4.3.2",
    "autoprefixer": "^10.5.2",
    "postcss": "^8.5.18",
    "prettier": "^3.9.5",
    "tailwindcss": "^4.3.2",
    "typescript": "^5.9.3",
    "wrangler": "^4.110.0"
  },
  "private": true
}
