---
import { Check, ChevronRight, Copy } from '@lucide/astro';
import type { NormalizedLink } from '../config/schema';
import { externalLinkAttributes, toSitePath } from '../config/urls';
import Icon from './Icon.astro';

interface Props {
  link: NormalizedLink;
}

const { link } = Astro.props;
const isCopyButton = link.specialType === 'copy';
const isLink = Boolean(link.url && !isCopyButton);
const classes = ['link-button', isCopyButton ? 'feedback-action copy-button-active' : '']
  .filter(Boolean)
  .join(' ');
---

{isLink ? (
  <a href={toSitePath(link.url)} {...externalLinkAttributes(link.url)} class={classes}>
    <Icon icon={link.icon} />
    <div class="button-text-wrapper">
      <span class="button-main-text">{link.label}</span>
      {link.subtitle && <span class="button-subtitle">{link.subtitle}</span>}
      {link.description && <span class="button-subtitle">{link.description}</span>}
    </div>
    <ChevronRight class="link-button-chevron" aria-hidden="true" />
  </a>
) : (
  <button
    type="button"
    class={classes}
    data-copy-value={isCopyButton ? link.copyValue : undefined}
    data-original-subtitle={isCopyButton ? link.subtitle : undefined}
  >
    <Icon icon={link.icon} />
    <div class="button-text-wrapper">
      <span class="button-main-text">{link.label}</span>
      <span class="button-subtitle" data-feedback-live aria-live="polite">
        {link.subtitle || 'Copy to clipboard'}
      </span>
      {link.description && <span class="button-subtitle">{link.description}</span>}
    </div>
    <span class="feedback-action-icon" aria-hidden="true">
      <Copy class="feedback-action-glyph feedback-action-glyph-default" />
      <Check class="feedback-action-glyph feedback-action-glyph-check" />
    </span>
  </button>
)}
